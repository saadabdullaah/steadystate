{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steadystate.dev/schemas/service-descriptor-v1alpha1.json",
  "title": "SteadyState generated service descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "template", "version", "components"],
  "properties": {
    "apiVersion": {"const": "cli.steadystate.dev/v1alpha1"},
    "kind": {"const": "ServiceDescriptor"},
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 48},
    "template": {"enum": ["go-api", "react-static", "full-stack"]},
    "version": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "application", "path", "runtime", "port", "dockerfile"],
        "properties": {
          "name": {"enum": ["api", "web"]},
          "application": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
          "path": {"enum": ["api", "web"]},
          "runtime": {"enum": ["go", "react-go"]},
          "port": {"const": 8080},
          "dockerfile": {"enum": ["api/Dockerfile", "web/Dockerfile"]}
        }
      }
    }
  }
}
