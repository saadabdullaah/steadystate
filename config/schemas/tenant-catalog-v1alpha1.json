{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steadystate.dev/schemas/tenant-catalog-v1alpha1.json",
  "title": "SteadyState Tenant Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "tenants"],
  "properties": {
    "apiVersion": {"const": "cli.steadystate.dev/v1alpha1"},
    "kind": {"const": "TenantCatalog"},
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "teamPath", "owners", "lifecycle", "applications", "databases", "services"],
        "properties": {
          "name": {"$ref": "#/$defs/teamName"},
          "teamPath": {"type": "string", "pattern": "^gitops/teams/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "owners": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\s]+$"}},
          "lifecycle": {"$ref": "#/$defs/lifecycle"},
          "deletionRequest": {"$ref": "#/$defs/requestID"},
          "applications": {"type": "array", "items": {"$ref": "#/$defs/application"}},
          "databases": {"type": "array", "items": {"$ref": "#/$defs/database"}},
          "services": {"type": "array", "items": {"$ref": "#/$defs/service"}}
        }
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "lifecycle"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "path": {"type": "string", "pattern": "^gitops/applications/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseRef": {"$ref": "#/$defs/name"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "deletionRequest": {"$ref": "#/$defs/requestID"}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "lifecycle"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "path": {"type": "string", "pattern": "^gitops/databases/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "deletionRequest": {"$ref": "#/$defs/requestID"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "template", "version", "components", "lifecycle"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 48},
        "path": {"type": "string", "pattern": "^services/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "template": {"enum": ["go-api", "react-static", "full-stack"]},
        "version": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "components": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "databaseRef": {"$ref": "#/$defs/name"},
        "ownsTeam": {"type": "boolean"},
        "ownsDatabase": {"type": "boolean"},
        "lifecycle": {"enum": ["Scaffolded", "Active", "Retiring"]},
        "deletionRequest": {"$ref": "#/$defs/requestID"}
      }
    },
    "teamName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 58
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "lifecycle": {"enum": ["Active", "Retiring"]},
    "requestID": {
      "type": "string",
      "format": "uuid"
    }
  }
}
